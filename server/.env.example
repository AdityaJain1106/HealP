# HealP Backend Server Environment Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Ensure firebase-service-account.json is placed in the server/ directory

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Supabase Configuration (Optional/Auxiliary)
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email Service (Nodemailer for Contact & Notifications)
CONTACT_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Administrator Bootstrap (comma-separated list of admin emails)
ADMIN_EMAILS=admin@example.com
